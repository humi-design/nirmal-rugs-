# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=0

# Database: mysql+pymysql://user:pass@host:3306/dbname  or leave blank for SQLite
DATABASE_URL=

# SMTP (optional — admin notifications + customer confirmations)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=1

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me